# Copy this file to .env and fill in real values before running the app.
# .env is git-ignored -- never commit real secrets.

# --- REQUIRED ---

# Your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Admin password for the researcher/PI dashboard.
# CHANGE THIS before collecting any real patient data.
# This is a placeholder, not a safe default -- do not use it as-is.
ADMIN_PASSWORD=changeme

# A long random string used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changeme-generate-a-real-random-secret

# --- OPTIONAL ---

# Port the server listens on (binds to 127.0.0.1 only, never 0.0.0.0).
PORT=3000

# Claude model used for the interview. Mid-tier model is sufficient for
# this structured conversational-elicitation task -- no need for a
# premium reasoning-tier model. Update this string as model names evolve.
CLAUDE_MODEL=claude-sonnet-5
